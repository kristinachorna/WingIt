# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Postgres connection
DATABASE_URL=postgresql://user:password@localhost:5432/camera_app

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# Object storage (fill in once we reach the photo-upload step)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
